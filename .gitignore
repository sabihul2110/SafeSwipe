<!-- SafeSwipe/.gitignore -->

# Private / internal notes — not meant for the public repo
docs/private/

# OS junk
.DS_Store

# Node
node_modules/
frontend/node_modules/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Environment variables / secrets
.env
.env.local

# Editor
.vscode/

# Frontend build output
frontend/dist/
frontend/build/

# Backend virtual environment (per-folder, in case it differs from root)
backend/venv/
ml/venv/